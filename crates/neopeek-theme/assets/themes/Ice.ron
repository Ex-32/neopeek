// Ice: cool blue/cyan family on deep blue-black.
(
    name: "Ice",
    background: "#05070e",
    waterfall: (
        past: "#6b9dff",
        future: "#a8d8ff",
        now_line: "#9ef0ff",
        rainbow: false,
        db_floor: -80.0,
        db_ceil: 0.0,
    ),
    waveform: ( color: "#4da6ff", width: 1.0 ),
    lissajous: ( color: "#8adfff", scale: 0.45 ),
    meters: ( grad_low: "#2ec4b6", grad_high: "#b04dff", peak_hold_ms: 800 ),
    hud: ( text: "#c8d8ee", dim: "#5a6f8a", font_size: 14.0, accent: "#9ef0ff" ),
)
