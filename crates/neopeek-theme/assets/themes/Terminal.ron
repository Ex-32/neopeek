// Terminal: phosphor green on near-black, mono accent.
(
    name: "Terminal",
    background: "#050805",
    waterfall: (
        past: "#33ff33",
        future: "#80ff80",
        now_line: "#e6ffe6",
        rainbow: false,
        db_floor: -80.0,
        db_ceil: 0.0,
    ),
    waveform: ( color: "#33ff33", width: 1.0 ),
    lissajous: ( color: "#b3ffb3", scale: 0.45 ),
    meters: ( grad_low: "#1f8c1f", grad_high: "#66ff66", peak_hold_ms: 800 ),
    hud: ( text: "#33ff33", dim: "#1f8c1f", font_size: 14.0, accent: "#ccff33" ),
)
