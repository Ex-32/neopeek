// Terminal: high-contrast phosphor-CRT hacker green on near-black.
(
    name: "Terminal",
    background: "#010401",
    waterfall: (
        past: "#39ff14",      // classic terminal green
        future: "#148f10",    // darker green for the filled mode
        now_line: "#b7ff2e",  // acid lime "now" edge
        rainbow: false,
        db_floor: -80.0,
        db_ceil: 0.0,
        // Filled-surface gradient: near-black phosphor floor → dark green
        // → classic terminal green → white-green tip (the luminance
        // swing, not hue, is the contrast in this monochrome family).
        surface_ramp: [
            (pos: 0.0, color: "#041608"),
            (pos: 0.4, color: "#148f10"),
            (pos: 0.7, color: "#39ff14"),
            (pos: 1.0, color: "#d8ffcc"),
        ],
    ),
    waveform: ( color: "#2aff6a", width: 1.0 ),
    lissajous: ( color: "#00ff9c", scale: 0.45 ),
    meters: ( grad_low: "#0f9d58", grad_high: "#ff3b30", peak_hold_ms: 800 ),
    hud: ( text: "#7dff9e", dim: "#2e7d4f", font_size: 14.0, accent: "#ff5d5d" ),
)