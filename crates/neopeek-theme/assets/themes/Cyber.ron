// Cyber: high-contrast bright-pink/cyan waterfall with electric-yellow
// Lissajous — hot-pink accent.
(
    name: "Cyber",
    background: "#050208",
    waterfall: (
        past: "#ff006e",       // hot pink
        future: "#ff5c9e",     // lighter pink for the filled mode
        now_line: "#ffd2c2",   // bright scarlet-white "now" edge
        rainbow: false,
        db_floor: -80.0,
        db_ceil: 0.0,
        // Filled-surface gradient: deep violet floor → magenta → hot-pink
        // accent → light pink → pink-white tip.
        surface_ramp: [
            (pos: 0.0, color: "#3a0645"),
            (pos: 0.35, color: "#a80a68"),
            (pos: 0.6, color: "#ff006e"),
            (pos: 0.8, color: "#ff7ab8"),
            (pos: 1.0, color: "#ffe9f4"),
        ],
    ),
    waveform: ( color: "#00e5ff", width: 1.0 ),
    lissajous: ( color: "#fff01a", scale: 0.45 ),
    meters: ( grad_low: "#00e5ff", grad_high: "#ff2400", peak_hold_ms: 800 ),
    hud: ( text: "#f2e9ff", dim: "#7a6f8f", font_size: 14.0, accent: "#ff006e" ),
)